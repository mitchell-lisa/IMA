{
  "name": "marketready-risk-diagnostic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:matrix": "tsx scripts/gen-question-matrix.mts > docs/question-matrix.md",
    "check": "npm run typecheck && npm run lint && npm run test",
    "docs:bank": "tsx scripts/export-bank.mts docs/question-bank.json && python3 scripts/build-workbook.py docs/question-bank.json docs/marketready-question-bank.xlsx",
    "docs:pack": "tsx scripts/gen-knowledge-pack.mts > docs/agent-knowledge-pack.md",
    "docs:all": "npm run docs:matrix && npm run docs:bank && npm run docs:pack"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "next": "15.5.25",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
